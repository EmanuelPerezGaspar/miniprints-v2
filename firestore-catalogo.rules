rules_version = '2';

// Reglas del proyecto de Firebase **miniprints-catalogo** (NO del proyecto del negocio).
// Pégalas en ese proyecto › Firestore Database › Reglas y reemplaza TU_UID_CATALOGO por el
// "UID de usuario" de tu cuenta en ese proyecto (Authentication › Usuarios).
//
// - Cualquiera puede LEER un solo documento: publico/estado (los avisos del catálogo).
// - Solo tu cuenta puede ESCRIBIRLO, y solo con la forma esperada: { p: {código: aviso}, t: número }.
// - Todo lo demás está cerrado. No hay datos del negocio en este proyecto.
service cloud.firestore {
  match /databases/{database}/documents {
    match /publico/estado {
      allow get: if true;
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid in ['v7oB5j8Bx8hR6dAfUPA1u7CEsff1']
        && request.resource.data.keys().hasOnly(['p', 't'])
        && request.resource.data.p is map
        && request.resource.data.p.size() <= 300
        && request.resource.data.t is int;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
