rules_version = '2';

// Reglas de seguridad de Firestore para MiniPrints.
// Solo la cuenta del negocio (inicio de sesión con correo) puede leer y escribir.
// Pégalas en Firebase › Firestore Database › Reglas y reemplaza TU_UID por el
// "UID de usuario" que aparece en Firebase › Authentication › Usuarios.
service cloud.firestore {
  match /databases/{database}/documents {
    match /negocio/{documento} {
      allow read, write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid in ['TU_UID'];
    }

    // Todo lo demás queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
